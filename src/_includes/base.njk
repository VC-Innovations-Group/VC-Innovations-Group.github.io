{#- ── Font catalog: maps CMS font keys to a CSS stack + Google Fonts param ── -#}
{%- set headingFonts = {
  "dm-serif":     { "stack": "'DM Serif Display', Georgia, serif",   "param": "DM+Serif+Display:ital@0;1" },
  "playfair":     { "stack": "'Playfair Display', Georgia, serif",   "param": "Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600" },
  "fraunces":     { "stack": "'Fraunces', Georgia, serif",           "param": "Fraunces:ital,wght@0,400;0,600;1,400;1,600" },
  "cormorant":    { "stack": "'Cormorant Garamond', Georgia, serif", "param": "Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600" },
  "lora":         { "stack": "'Lora', Georgia, serif",               "param": "Lora:ital,wght@0,500;0,600;1,500;1,600" },
  "libre-caslon": { "stack": "'Libre Caslon Display', Georgia, serif", "param": "Libre+Caslon+Display" }
} -%}
{%- set bodyFonts = {
  "inter":        { "stack": "'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif", "param": "Inter:wght@400;500;600;700" },
  "work-sans":    { "stack": "'Work Sans', system-ui, sans-serif",      "param": "Work+Sans:wght@400;500;600;700" },
  "dm-sans":      { "stack": "'DM Sans', system-ui, sans-serif",        "param": "DM+Sans:wght@400;500;600;700" },
  "plus-jakarta": { "stack": "'Plus Jakarta Sans', system-ui, sans-serif", "param": "Plus+Jakarta+Sans:wght@400;500;600;700" },
  "nunito-sans":  { "stack": "'Nunito Sans', system-ui, sans-serif",    "param": "Nunito+Sans:wght@400;500;600;700" },
  "source-sans":  { "stack": "'Source Sans 3', system-ui, sans-serif",  "param": "Source+Sans+3:wght@400;500;600;700" },
  "figtree":      { "stack": "'Figtree', system-ui, sans-serif",        "param": "Figtree:wght@400;500;600;700" }
} -%}
{%- set hf = headingFonts[theme.headingFont] or headingFonts["dm-serif"] -%}
{%- set bf = bodyFonts[theme.bodyFont] or bodyFonts["inter"] -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ site.metaTitle }}</title>
  <meta name="description" content="{{ site.metaDescription }}" />
  <meta property="og:title" content="{{ site.brandName }}" />
  <meta property="og:description" content="{{ site.metaDescription }}" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="{{ site.url }}" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family={{ hf.param }}&family={{ bf.param }}&display=swap" rel="stylesheet" />

  <style>
    :root {
      /* ── Brand palette (CMS-editable) ─────────────── */
      --cream:      {{ theme.colors.cream }};
      --card:       {{ theme.colors.card }};
      --navy:       {{ theme.colors.navy }};
      --navy-light: {{ theme.colors.navyLight }};
      --rust:       {{ theme.colors.rust }};

      /* ── Warm-gray neutrals (fixed) ───────────────── */
      --wg100: #F0EBE2;
      --wg200: #E4DDD3;
      --wg300: #D4CCC2;
      --wg400: #B8B0A6;
      --wg500: #9E9690;
      --wg600: #5C5449;

      /* ── Fonts (CMS-editable) ─────────────────────── */
      --serif: {{ hf.stack | safe }};
      --sans:  {{ bf.stack | safe }};

      --max: {{ theme.maxWidth }}px;
      --radius-lg: 24px;
      --radius-md: 16px;
      --shadow-sm: 0 2px 8px rgba(28,54,73,0.07);
      --shadow-md: 0 12px 32px rgba(28,54,73,0.12);
      --shadow-lg: 0 24px 60px rgba(28,54,73,0.16);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
    body {
      font-family: var(--sans);
      background: var(--cream);
      color: var(--navy);
      line-height: 1.6;
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }
    img { display: block; max-width: 100%; }
    a { color: inherit; text-decoration: none; }

    .wrap { width: 100%; max-width: var(--max); margin: 0 auto; padding: 0 24px; }

    /* ── Shared type ─────────────────────────────── */
    .eyebrow {
      font-family: var(--sans); font-weight: 500;
      font-size: 11px; letter-spacing: 2px; text-transform: uppercase;
      color: var(--rust);
    }
    h1, h2, h3 { font-family: var(--serif); font-weight: 400; color: var(--navy); letter-spacing: 0.01em; }
    .italic { font-style: italic; color: var(--rust); }
    .lede { color: var(--wg600); font-size: clamp(15px, 1.4vw, 17px); max-width: 54ch; }

    .btn {
      display: inline-flex; align-items: center; gap: 9px;
      font-family: var(--sans); font-weight: 500; font-size: 12px;
      letter-spacing: 1.2px; text-transform: uppercase;
      padding: 14px 26px; border-radius: 999px; cursor: pointer;
      border: 1px solid transparent; transition: transform .18s ease, box-shadow .18s ease, background .18s ease, color .18s ease;
    }
    .btn-primary { background: var(--rust); color: var(--cream); }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 26px rgba(184,92,56,0.35); }
    .btn-ghost { background: transparent; color: var(--navy); border-color: var(--wg300); }
    .btn-ghost:hover { border-color: var(--navy); transform: translateY(-2px); }

    /* ── Header ─────────────────────────────── */
    header {
      position: sticky; top: 0; z-index: 50;
      background: rgba(240,235,224,0.82);
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--wg200);
    }
    .nav { display: flex; align-items: center; justify-content: space-between; height: 72px; }
    .brand { display: flex; align-items: center; gap: 12px; }
    .brand .mark {
      width: 38px; height: 38px; border-radius: 11px; background: var(--navy);
      display: grid; place-items: center; flex-shrink: 0;
      font-family: var(--serif); font-style: italic; color: var(--cream); font-size: 17px;
    }
    .brand .name { font-family: var(--serif); font-size: 19px; color: var(--navy); white-space: nowrap; }
    .nav-links { display: flex; align-items: center; gap: 34px; }
    .nav-links a {
      font-family: var(--sans); font-size: 12px; letter-spacing: 0.6px; color: var(--wg600);
      transition: color .15s ease;
    }
    .nav-links a:hover { color: var(--rust); }
    .nav-cta { display: flex; align-items: center; gap: 18px; }
    .nav-cta .btn { padding: 10px 20px; }

    /* ── Hero ─────────────────────────────── */
    .hero { padding: clamp(56px, 8vw, 104px) 0 clamp(48px, 6vw, 88px); }
    .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
    .hero h1 { font-size: clamp(40px, 6vw, 68px); line-height: 1.06; margin: 22px 0 24px; }
    .hero .lede { font-size: clamp(15px, 1.5vw, 18px); }
    .hero .cta { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 36px; }
    .hero-media { position: relative; }
    .hero-media img {
      width: 100%; aspect-ratio: 825 / 782; height: auto; object-fit: contain;
      border-radius: var(--radius-lg);
    }
    .hero-badge {
      position: absolute; left: -18px; bottom: 28px;
      background: var(--card); border: 1px solid var(--wg200);
      border-radius: var(--radius-md); padding: 16px 20px; box-shadow: var(--shadow-md);
      display: flex; align-items: center; gap: 14px; max-width: 250px;
      transition: transform .18s ease, box-shadow .18s ease;
    }
    a.hero-badge { cursor: pointer; }
    a.hero-badge:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); }
    .hero-badge .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--rust); flex-shrink: 0;
      box-shadow: 0 0 0 4px rgba(184,92,56,0.15); }
    .hero-badge .t { font-family: var(--serif); font-style: italic; font-size: 17px; color: var(--navy); line-height: 1.2; }
    .hero-badge .s { font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--wg500); }

    /* ── Section scaffold ─────────────────────────────── */
    section.block { padding: clamp(64px, 9vw, 120px) 0; }
    .sec-head { max-width: 640px; margin-bottom: clamp(40px, 5vw, 64px); }
    .sec-head h2 { font-size: clamp(30px, 4vw, 46px); line-height: 1.12; margin-top: 16px; }
    .sec-head p { margin-top: 18px; }

    /* ── Approach cards ─────────────────────────────── */
    .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
    .card {
      background: var(--card); border: 1px solid var(--wg200); border-radius: var(--radius-md);
      padding: 32px 28px; transition: transform .2s ease, box-shadow .2s ease;
    }
    .card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
    .card .num { font-family: var(--serif); font-style: italic; font-size: 30px; color: var(--rust); }
    .card h3 { font-size: 22px; margin: 14px 0 10px; }
    .card p { color: var(--wg600); font-size: 14px; }

    /* ── Ventures ─────────────────────────────── */
    .feature {
      display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 4vw, 56px); align-items: center;
      background: var(--card); border: 1px solid var(--wg200); border-radius: var(--radius-lg);
      overflow: hidden;
    }
    .feature .media { height: 100%; min-height: 340px; }
    .feature .media img { width: 100%; height: 100%; object-fit: cover; min-height: 340px; }
    .feature .body { padding: clamp(32px, 4vw, 52px) clamp(28px, 4vw, 52px) clamp(32px, 4vw, 52px) 0; }
    .pill {
      display: inline-flex; align-items: center; gap: 7px;
      font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--navy);
      background: var(--wg100); border: 1px solid var(--wg200); border-radius: 999px; padding: 6px 12px;
    }
    .pill .dot { width: 7px; height: 7px; border-radius: 50%; background: #4A7C59; }
    .feature h3 { font-size: clamp(30px, 4vw, 44px); margin: 18px 0 14px; }
    .feature p { color: var(--wg600); margin-bottom: 22px; }
    .arrow-link { font-family: var(--sans); font-size: 12px; letter-spacing: 1px; text-transform: uppercase; color: var(--rust); font-weight: 500; }
    .arrow-link:hover { text-decoration: underline; }

    .mini-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 22px; margin-top: 22px; }
    .mini {
      position: relative; border-radius: var(--radius-md); overflow: hidden; min-height: 220px;
      border: 1px solid var(--wg200);
    }
    .mini img { width: 100%; height: 100%; min-height: 220px; object-fit: cover; filter: saturate(0.9); }
    .mini .overlay {
      position: absolute; inset: 0; background: linear-gradient(180deg, rgba(28,54,73,0) 30%, rgba(28,54,73,0.82) 100%);
      display: flex; flex-direction: column; justify-content: flex-end; padding: 24px;
    }
    .mini .overlay .pill { color: var(--cream); background: rgba(253,250,246,0.12); border-color: rgba(253,250,246,0.25); }
    .mini .overlay .pill .dot { background: var(--wg300); }
    .mini .overlay h3 { color: var(--cream); font-size: 26px; margin-top: 12px; }
    .mini .overlay p { color: rgba(240,235,224,0.82); font-size: 13px; margin-top: 4px; }

    /* ── About ─────────────────────────────── */
    .about { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
    .about-media img { width: 100%; height: clamp(340px, 42vw, 500px); object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow-md); }
    .about h2 { font-size: clamp(30px, 4vw, 46px); line-height: 1.12; margin: 16px 0 20px; }
    .about p { color: var(--wg600); margin-bottom: 16px; }
    .founders { display: flex; gap: 28px; margin-top: 28px; flex-wrap: wrap; }
    .founder .fn { font-family: var(--serif); font-size: 20px; color: var(--navy); }
    .founder .fr { font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase; color: var(--rust); }

    /* ── CTA band ─────────────────────────────── */
    .cta-band { background: var(--navy); border-radius: var(--radius-lg); padding: clamp(48px, 7vw, 84px) clamp(28px, 5vw, 72px); text-align: center; }
    .cta-band .eyebrow { color: #D9A38C; }
    .cta-band h2 { color: var(--cream); font-size: clamp(30px, 4.5vw, 52px); line-height: 1.1; margin: 16px auto 14px; max-width: 16ch; }
    .cta-band .italic { color: #E0916B; }
    .cta-band p { color: rgba(240,235,224,0.7); max-width: 48ch; margin: 0 auto 32px; }

    /* ── Footer ─────────────────────────────── */
    footer { border-top: 1px solid var(--wg200); padding: 56px 0 40px; }
    .foot-grid { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 28px; align-items: flex-start; }
    .foot-links { display: flex; gap: 40px; flex-wrap: wrap; }
    .foot-col h4 { font-family: var(--sans); font-weight: 500; font-size: 10px; letter-spacing: 2px; text-transform: uppercase; color: var(--wg500); margin-bottom: 14px; }
    .foot-col a, .foot-col span { display: block; font-size: 13px; color: var(--wg600); margin-bottom: 9px; }
    .foot-col a:hover { color: var(--rust); }
    .foot-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--wg200); }
    .foot-bottom span { font-size: 11px; color: var(--wg500); letter-spacing: 0.5px; }
    .foot-bottom a { color: var(--wg500); }
    .foot-bottom a:hover { color: var(--rust); }

    /* ── Reveal animation ─────────────────────────────── */
    .reveal { opacity: 0; transform: translateY(20px); transition: opacity .7s ease, transform .7s ease; }
    .reveal.in { opacity: 1; transform: none; }

    /* ── Responsive ─────────────────────────────── */
    @media (max-width: 920px) {
      .hero-grid { grid-template-columns: 1fr; }
      .hero-media { order: -1; }
      .feature, .about { grid-template-columns: 1fr; }
      .feature .body { padding: 0 clamp(24px, 6vw, 40px) clamp(32px, 6vw, 44px); }
      .feature .media img { min-height: 300px; height: 320px; }
      .about-media { order: -1; }
    }
    @media (max-width: 760px) {
      .nav-links { display: none; }
      .cards { grid-template-columns: 1fr; }
      .mini-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 520px) {
      .wrap { padding: 0 18px; }
      .hero-badge { left: 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      .reveal { opacity: 1; transform: none; transition: none; }
      html { scroll-behavior: auto; }
    }
  </style>
</head>
<body>
{{ content | safe }}

  <script>
    document.getElementById('year').textContent = new Date().getFullYear();
    // Lightweight scroll reveal
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</body>
</html>
